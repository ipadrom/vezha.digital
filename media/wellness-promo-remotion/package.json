{
  "name": "training-product-film",
  "version": "1.0.0",
  "private": true,
  "description": "Editorial product film for the Training case",
  "scripts": {
    "dev": "remotion studio --no-open",
    "lint": "eslint src && tsc",
    "render": "remotion render TrainingProductFilm out/wellness-promo.mp4 --codec=h264 --crf=20 --pixel-format=yuv420p",
    "poster": "remotion still TrainingProductFilm out/wellness-promo-poster.jpg --frame=516"
  },
  "dependencies": {
    "@remotion/cli": "4.0.507",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.507"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.507",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "9.19.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "sideEffects": [
    "*.css"
  ]
}
