{
  "name": "gbu-crew-graph-remotion",
  "version": "1.0.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "Anonymised crew relationship graph for the VEZHA Digital case",
  "scripts": {
    "dev": "remotion studio --no-open",
    "lint": "eslint src && tsc",
    "render": "remotion render CrewRelationshipGraph out/crew-network-graph.mp4 --codec=h264 --crf=16 --scale=2",
    "poster": "remotion still CrewRelationshipGraph out/crew-network-graph-poster.jpg --frame=300 --scale=2 --image-format=jpeg --jpeg-quality=95"
  },
  "dependencies": {
    "@remotion/cli": "4.0.507",
    "@remotion/google-fonts": "4.0.507",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.507"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.507",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "9.19.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  }
}
